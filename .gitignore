
# Godot-specific ignores
game/.godot
#game/export.cfg
#game/export_presets.cfg

# Import Stuff
*.kra~
*.blend1
*.kra-autosave*

# Mono-specific ignores
.mono/
data_*/

# Mobile Export Stuff
game/ios/
#game/android/
game/exports/
game/exports

# AAOS
*.apk
*.patch
*.diff
# 1. Ignore everything inside the build folder
game/android/build/*
# 2. But do not ignore the subdirectories if they contain the file (crucial for nesting)
#![Aa]ndroid/build/**/
# 3. Explicitly include the specific file
!game/android/build/AndroidManifest.xml
!game/android/build/gradle.properties
